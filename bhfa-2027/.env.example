# ---------------------------------------------------------------------------
# BHFA 2027 Program Room — environment
# Copy to .env.local for local development. Never commit real values.
# ---------------------------------------------------------------------------

# Which persistence driver to use: "supabase" (production) or "memory" (local
# demo / tests only — data lives in the server process and is lost on restart).
# Defaults to "supabase" when SUPABASE_URL is set, otherwise "memory".
PROGRAM_DATA_DRIVER=supabase

# Supabase project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=

# Service-role key. SERVER ONLY. Never prefix with NEXT_PUBLIC_ and never send
# it to the browser — every database call happens inside route handlers.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: pepper mixed into the collaboration-token hash. Set it once and keep
# it stable; changing it invalidates every existing collaboration link.
COLLAB_TOKEN_PEPPER=

# Optional: seed token used by `npm run db:seed` so you can pin a known link in
# a staging environment. Leave empty in production — the seed script generates a
# high-entropy token and prints it once.
SEED_COLLAB_TOKEN=

# Port (Railway injects this automatically).
PORT=3000
