{
  "name": "bhfa-2027-program",
  "version": "1.0.0",
  "private": true,
  "description": "Beverly Hills Face Academy 2027 \u2014 collaborative scientific program planning room",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p ${PORT:-3000}",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:apply": "node scripts/apply-migrations.mjs",
